<?xml version="1.0"?>
<sdf version="1.7">
  <model name="stereo_rig">
    <static>true</static>
    <link name="stereo_left_camera_optical_frame">
      <pose>0 0 0.50 0 0 0</pose>
      <visual name="housing">
        <geometry><box><size>0.04 0.12 0.04</size></box></geometry>
        <material><ambient>0.05 0.20 0.80 1</ambient></material>
      </visual>
      <sensor name="stereo_rig" type="multicamera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <camera name="left">
          <horizontal_fov>1.138626</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.10</near><far>4.00</far></clip>
        </camera>
        <camera name="right">
          <pose>0 -0.06 0 0 0 0</pose>
          <horizontal_fov>1.138626</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.10</near><far>4.00</far></clip>
        </camera>
        <plugin name="stereo_camera" filename="libgazebo_ros_camera.so">
          <ros><namespace>/stereo</namespace></ros>
          <camera_name>stereo_rig</camera_name>
          <frame_name>stereo_left_camera_optical_frame</frame_name>
          <hack_baseline>0.06</hack_baseline>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
