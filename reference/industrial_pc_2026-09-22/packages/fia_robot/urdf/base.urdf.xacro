<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="YH_FIA_ROO1">
<!-- <xacro:include xmlns:xacro="http://www.ros.org/wiki/xacro"> -->

  <!-- 材质定义 -->
  <xacro:property name="gray_metal" value="0.7 0.7 0.7 0.7"/>
  <xacro:property name="white" value="1 1 1 1"/>
  <xacro:property name="light_blue" value="0.741 0.902 0.957 1"/>
  <xacro:property name="dark_gray" value="0.376 0.376 0.376 1"/>

  <!-- base_footprint -->
  <!-- <link name="base_footprint"/>
  <joint name="footprint_to_base" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint> -->

  <!-- base_link -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.0251070620224986 0.00614048061720733 0.0609796911194103" rpy="0 0 0"/>
      <mass value="3.04966217910594"/>
      <inertia 
        ixx="0.0170838543964428"
        ixy="8.97603896378E-06"
        ixz="-0.000103914094165596"
        iyy="0.022263579823766"
        iyz="-1.53816933043532E-07"
        izz="0.0374090687091319" />
    </inertial>
    <visual>
      <origin xyz="-0.1307 0 0" rpy="0 0 0"/> <!-- origin xyz="0 0 0" rpy="0 0 0" -->
      <geometry>
        <mesh filename="package://fia_robot/meshes/chassis_meshes/base_link.STL"/>
      </geometry>
      <material name="gray_metal">
        <color rgba="${gray_metal}"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.1307 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://fia_robot/meshes/chassis_meshes/base_link.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- camera_link -->
  <link name="camera_link">
    <inertial>
      <origin xyz="5.09861291242419E-08 -3.47825186031378E-07 1.07581484304342E-07" rpy="0 0 0"/>
      <mass value="0.0559842504443458"/>
      <inertia
        ixx="0.000130810956607069"
        ixy="1.20255882163315E-07"
        ixz="1.62335432754277E-06"
        iyy="1.91148632550972E-05"
        iyz="-2.80018266441135E-08"
        izz="0.000131387466610814" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://fia_robot/meshes/chassis_meshes/camera_link.STL"/>
      </geometry>
      <material name="white">
        <color rgba="${white}"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://fia_robot/meshes/chassis_meshes/camera_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <origin xyz="0.03746 0.000078 0.186704" rpy="0 0 0"/> <!-- 0.16816 0.000078 0.186704 -->
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

  <!-- laser_link -->
  <link name="laser_link">
    <inertial>
      <origin xyz="0.0025063031131769 -4.56584106021334E-06 -0.0193246896050287" rpy="0 0 0"/>
      <mass value="0.0374307357771753"/>
      <inertia
        ixx="2.80476450261731E-05"
        ixy="-2.19900342508599E-09"
        ixz="1.07118438627127E-06"
        iyy="3.36164872401846E-05"
        iyz="6.83963621545873E-10"
        izz="4.50845485902709E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://fia_robot/meshes/chassis_meshes/laser.STL"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="${dark_gray}"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://fia_robot/meshes/chassis_meshes/laser.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="laser_joint" type="fixed">
    <origin xyz="0.0255 0 0.1184" rpy="0 0 0"/> <!-- 0.1562 0 0.1184 -->
    <parent link="base_link"/>
    <child link="laser_link"/>
  </joint>

  <!-- lf_wheel_link -->
  <link name="lf_wheel_link">
    <inertial>
      <origin xyz="-5.20829168682013E-09 -4.4527808014394E-07 2.77555756156289E-17" rpy="0 0 0"/>
      <mass value="0.595489655285518"/>
      <inertia
        ixx="0.000649719212067496"
